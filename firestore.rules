rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir acesso total temporariamente para recuperação da conta de administrador
    // Importante: Estas regras devem ser revisadas e tornadas mais restritivas após a recuperação do acesso
    match /{document=**} {
      allow read, write: if true;
    }
  }
}